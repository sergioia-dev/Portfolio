{
  "name": "back-end",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "hooks": "git config core.hooksPath ../.githooks",
    "dev": "nodemon --watch src --ext ts --exec \"node --env-file=.env -r ts-node/register\" src/index.ts",
    "build": " tsc",
    "start": "node build/src/index.js",
    "test": "biome check --error-on-warnings . && jest --coverage",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:lint": "biome check --error-on-warnings .",
    "test:format": "biome check --write .",
    "db:up": "podman compose up -d",
    "migration:run": "node --env-file=.env ./node_modules/typeorm/cli-ts-node-commonjs.js migration:run -d src/shared/database/data-source.ts",
    "migration:revert": "node --env-file=.env ./node_modules/typeorm/cli-ts-node-commonjs.js migration:revert -d src/shared/database/data-source.ts",
    "migration:show": "node --env-file=.env ./node_modules/typeorm/cli-ts-node-commonjs.js migration:show -d src/shared/database/data-source.ts",
    "migration:generate": "node --env-file=.env ./node_modules/typeorm/cli-ts-node-commonjs.js migration:generate -d src/shared/database/data-source.ts",
    "db:setup": "pnpm run db:up && pnpm run migration:run && pnpm run seeds:run",
    "seeds:run": "node --env-file=.env --import tsx database/seeder/run.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.27.0",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-slow-down": "^3.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
